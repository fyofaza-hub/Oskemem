# Oskemen Culture — переменные окружения.
# Всё с префиксом VITE_ попадает в клиентский бандл: секретов такой ключ носить нельзя.
# Скопируйте файл в .env.local и заполните нужные строки, затем перезапустите dev-сервер.

# Supabase (необязательно — пока приложение полностью работает локально)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Groq — AI-гид «Өскемен» (модель qwen/qwen3.8-27b; llama-3.1-8b-instant выведена из списка доступных).
# Бесплатный ключ: https://console.groq.com/keys
# VITE_GROQ_API_KEY виден в DevTools — для продакшена проксируйте запрос на сервере.
VITE_GROQ_API_KEY=
